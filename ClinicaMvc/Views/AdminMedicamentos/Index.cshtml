@model IEnumerable<Medicamento>

@{
    ViewData["Title"] = "Administracion";
    var cultura = new CultureInfo("es-CL");
}

<section class="page-title admin-title">
    <div>
        <p class="eyebrow">Panel de administracion</p>
        <h1>Medicamentos</h1>
    </div>
    <a class="button primary" asp-action="Crear">Nuevo medicamento</a>
</section>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="notice">@mensaje</div>
}

<section class="section table-section">
    <div class="responsive-table">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Categoria</th>
                    <th>Laboratorio</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Vencimiento</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var medicamento in Model)
                {
                    <tr>
                        <td>@medicamento.Id</td>
                        <td>@medicamento.Nombre</td>
                        <td>@medicamento.Categoria</td>
                        <td>@medicamento.Laboratorio</td>
                        <td>@medicamento.Precio.ToString("C0", cultura)</td>
                        <td>@medicamento.Stock</td>
                        <td>@medicamento.FechaVencimiento.ToString("dd-MM-yyyy")</td>
                        <td class="actions">
                            <a asp-action="Editar" asp-route-id="@medicamento.Id">Editar</a>
                            <a asp-action="Eliminar" asp-route-id="@medicamento.Id" class="danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
