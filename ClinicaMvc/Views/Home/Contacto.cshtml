@{
    ViewData["Title"] = "Contacto";
}

<section class="page-title">
    <p class="eyebrow">Canales de atencion</p>
    <h1>Contacto</h1>
</section>

<section class="section contact-grid">
    <article class="info-panel">
        <h2>Farmacia Vida Sana</h2>
        <p>Av. Principal 123, Santiago</p>
        <p>Telefono: +56 2 2345 6789</p>
        <p>Email: contacto@vidasana.cl</p>
    </article>

    <form class="contact-form">
        <label for="nombre">Nombre</label>
        <input id="nombre" name="nombre" type="text" placeholder="Tu nombre" />

        <label for="email">Correo</label>
        <input id="email" name="email" type="email" placeholder="correo@ejemplo.cl" />

        <label for="mensaje">Mensaje</label>
        <textarea id="mensaje" name="mensaje" rows="5" placeholder="Escribe tu consulta"></textarea>

        <button type="button" class="button primary">Enviar consulta</button>
    </form>
</section>
