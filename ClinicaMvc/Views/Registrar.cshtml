@model ClinicaMVC.Models.Paciente

@{
    ViewData["Title"] = "Registro de Paciente";
    var mostrarBoleta = Model is not null && Model.TotalPagar > 0;
}

<style>
    .contenedor {
        max-width: 500px;
        margin: 40px auto;
        padding: 25px;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        font-family: Arial, sans-serif;
    }

    h2, h3 {
        text-align: center;
        color: #1f4e79;
    }

    label {
        font-weight: bold;
        display: block;
        margin-bottom: 6px;
    }

    input, select {
        width: 100%;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #ccc;
        margin-bottom: 15px;
    }

    button {
        width: 100%;
        padding: 12px;
        background-color: #1f4e79;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
    }

    button:hover {
        background-color: #163a5a;
    }

    .error {
        color: #b00020;
        margin-bottom: 15px;
    }

    .resumen {
        margin-top: 20px;
        padding: 15px;
        background-color: #eef6ff;
        border-radius: 8px;
    }

    .boleta {
        margin-top: 20px;
        padding: 15px;
        background-color: #f4fff4;
        border: 1px solid #b7dfb7;
        border-radius: 8px;
    }
</style>

<div class="contenedor">
    <h2>Registro de Paciente</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="error">
            Revise los datos ingresados.
        </div>
    }

    <form action="/Paciente/Registrar" method="post">
        <label>Nombre:</label>
        <input type="text" name="Nombre" value="@Model?.Nombre" required />

        <label>Edad:</label>
        <input type="number" name="Edad" min="1" value="@(Model?.Edad > 0 ? Model.Edad : string.Empty)" required />

        <label>¿Tiene previsión?</label>
        <select name="TienePrevision">
            <option value="true" selected="@(Model?.TienePrevision == true)">Sí</option>
            <option value="false" selected="@(Model?.TienePrevision == false)">No</option>
        </select>

        <label>Tipo de atención:</label>
        <select name="TipoAtencion" required>
            <option value="1" selected="@(Model?.TipoAtencion == 1)">Consulta general - $10.000</option>
            <option value="2" selected="@(Model?.TipoAtencion == 2)">Urgencia - $25.000</option>
            <option value="3" selected="@(Model?.TipoAtencion == 3)">Examen - $15.000</option>
        </select>

        <button type="submit">Generar Boleta</button>
    </form>

    @if (mostrarBoleta)
    {
        <div class="boleta">
            <h3>Boleta</h3>
            <p>Paciente: @Model!.Nombre</p>
            <p>Edad: @Model.Edad</p>
            <p>Costo base: $@Model.CostoBase.ToString("N0")</p>
            <p>Descuento: $@Model.Descuento.ToString("N0")</p>
            <p>Total a pagar: $@Model.TotalPagar.ToString("N0")</p>
        </div>
    }

    <div class="resumen">
        <h3>Resumen del Día</h3>
        <p>Pacientes atendidos: @ViewBag.TotalPacientes</p>
        <p>Total recaudado: $@(((int)(ViewBag.TotalRecaudado ?? 0)).ToString("N0"))</p>
    </div>
</div>
